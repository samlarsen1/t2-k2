# Trading212 API. Needs the "Portfolio" and "Orders" read permissions to evaluate, plus
# "Orders execute" to place sell orders with --execute. Start on demo.
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here
# Demo
#T212_BASE_URL=https://demo.trading212.com
# Live
T212_BASE_URL=https://live.trading212.com

# Overbought + harvesting rules (optional; defaults to config/strategy.yaml)
#T2K2_STRATEGY_FILE=config/strategy.yaml

# Logging
LOG_LEVEL=INFO
